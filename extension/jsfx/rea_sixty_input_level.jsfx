desc:Rea-Sixty Input Level
author:Rea-Sixty
tags:metering analysis
// rev 14

// Stereo input-level probe. Shipped with the Rea-Sixty REAPER extension so
// the UC1's dedicated input meter can show the level of whatever signal is
// flowing INTO this plug-in — egal was vorher kommt: a live armed/monitored
// hardware input, the output of an upstream plug-in, or a media source.
//
// Why this exists: the extension's normal input meter reads samples at the
// project playhead via AudioAccessor, so it only ever sees recorded/playing
// media and is gated on the transport running. It cannot meter a live input
// while stopped. Drop this probe anywhere in a track's FX chain (including
// the input/record FX chain) and the extension reads its peak instead.
//
// Placement: anywhere. Audio passes through unchanged (pure measurement).
//   - Channels 1-2: signal to meter (passed through untouched)
//
// The extension finds this plug-in by name ("Rea-Sixty Input Level") on the
// focused track and reads slider1/2 (peak L/R in dBFS) via TrackFX_GetParam
// on its timer tick. When the probe is absent the extension falls back to its
// AudioAccessor input meter.

slider1:-120<-120,24,0.01>Peak L (dBFS)
slider2:-120<-120,24,0.01>Peak R (dBFS)

in_pin:In L
in_pin:In R
out_pin:Out L
out_pin:Out R

@init
eps = 0.000000000001; // 1e-12; EEL2 has no exponent-notation literals
hold_l = 0;
hold_r = 0;
hsamp_l = 0;          // remaining flat-hold samples (L)
hsamp_r = 0;          // remaining flat-hold samples (R)
// FLAT peak-hold window, NO decay. The probe reports the true peak over the
// last ~40 ms then snaps back to the live level — it does NOT impose its own
// fall. The extension owns the visible ballistics (peak-hold + tunable decay,
// or VU), so the UC1 input and output meters share one decay. The window only
// has to outlast the host's ~30 Hz read so no transient is missed before it
// is read. (rev 11 had a 150 ms exp decay here that fell ~2× faster than the
// output meter — Frank 2026-06-03.)
htime = 44100 * 0.04;  // 40 ms > one host read interval

@block
// Publish the previous block's held peak as dBFS (one block of latency,
// ~1 ms — negligible), then refresh the hold window for this block's srate.
db_l = 20 * log10(hold_l + eps);
db_r = 20 * log10(hold_r + eps);
db_l < -120 ? db_l = -120;
db_r < -120 ? db_r = -120;
// Plain slider write, no notify — exactly how HeDa Track_Inspector and other
// metering JSFX publish a DSP-computed value for external readers. The slider
// variable IS the host parameter storage; TrackFX_GetParam reads it live. NO
// sliderchange (display only) and NO slider_automate (would record automation
// — banned for a meter). The write alone feeds the UC1.
slider1 = db_l;
slider2 = db_r;
htime = srate * 0.04;

@sample
// Absolute peak with a flat-hold window, NO decay. A rising edge latches
// instantly and re-arms the window; while the window runs the peak stays put
// so the host always reads the true level; once it expires the hold snaps
// down to the live rectified sample — the extension, not the probe, applies
// the visible fall.
al = abs(spl0);
ar = abs(spl1);
al > hold_l ? ( hold_l = al; hsamp_l = htime; )
            : ( hsamp_l > 0 ? ( hsamp_l -= 1; ) : ( hold_l = al; ) );
ar > hold_r ? ( hold_r = ar; hsamp_r = htime; )
            : ( hsamp_r > 0 ? ( hsamp_r -= 1; ) : ( hold_r = ar; ) );
// Pass-through: spl0 / spl1 untouched (JSFX default forwards them).

@gfx 180 200
// Two vertical peak meters (L / R) so the FX window reads as a meter, not
// two faders. slider1 / slider2 are still the data channel to the extension;
// here they are only displayed.
gfx_set(0.07, 0.07, 0.08, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

dbmin = -60; dbmax = 6;          // displayed scale
pad   = 14;
labh  = 18;                      // room for the L / R + value labels
mtop  = 8;
mh    = gfx_h - mtop - labh;
bw    = (gfx_w - pad * 3) / 2;

// 0 dB reference line across both bars
zfrac = (0 - dbmin) / (dbmax - dbmin);
zy    = mtop + mh - zfrac * mh;
gfx_set(0.35, 0.35, 0.38, 1);
gfx_line(pad - 4, zy, gfx_w - pad + 4, zy);

i = 0;
loop(2,
  v = i == 0 ? slider1 : slider2;
  v < dbmin ? v = dbmin;
  v > dbmax ? v = dbmax;
  frac = (v - dbmin) / (dbmax - dbmin);
  bx   = pad + i * (bw + pad);

  // trough
  gfx_set(0.16, 0.16, 0.18, 1);
  gfx_rect(bx, mtop, bw, mh);

  // fill (green < -12, amber < -3, red above)
  fh = frac * mh;
  v > -3  ? gfx_set(0.90, 0.22, 0.20, 1)
  : (v > -12 ? gfx_set(0.92, 0.72, 0.20, 1)
  :            gfx_set(0.22, 0.80, 0.34, 1));
  gfx_rect(bx, mtop + mh - fh, bw, fh);

  // channel label + dB value
  gfx_set(0.82, 0.82, 0.85, 1);
  gfx_x = bx; gfx_y = mtop + mh + 3;
  gfx_drawstr(i == 0 ? "L " : "R ");
  gfx_drawnumber(v, 1);
  i += 1;
);
