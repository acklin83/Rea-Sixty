# macOS
.DS_Store

# Build output
build/
*.dylib
*.dll
*.so

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor
.vscode/
.idea/

# Scratch
.tmp/

# Large captures — keep selective ones via git add -f
captures/**/*.pcapng
captures/**/*.pcap
captures/**/*.MOV
captures/**/*.mov
captures/**/*.mp4
!captures/.keep

# CMake build outputs
extension/build/
extension/build-dbg/

# Vendored SDKs (fetched on demand)
extension/vendor/

# Claude Code session-local state
.claude/

# Cross-platform build artifacts
dist-windows/

# Release artifacts (zips + staging dirs, regenerated per release)
dist/stage-*/
dist/rea-sixty-mac-*.zip
dist/rea-sixty-win-*.zip
dist/rea-sixty-x86_64-*.zip
dist/rea-sixty-linux-*.zip
dist/rea-sixty-linux-*.tar.gz

# Forum drafts — not for public history
dist/forum-post*.txt
dist/forum-post*.md

# Local agent / planning artefacts — stay out of the public repo
CLAUDE.md
docs/plan-*.md
docs/handoff-*.md
docs/youre-finally-free.md
docs/video-script.md

# Local-only docs (credentials, runbooks — never push)
.local-docs/

# Stream Deck plugin runtime logs
streamdeck/**/logs/
# Bundled dependency (reproduced via `npm install`) + packed artifact
streamdeck/**/node_modules/
streamdeck/dist/
# Obsidian editor config
docs/.obsidian/

# Local RE probes — tools for one experiment, not shipped to users.
# They stay on disk; they just do not belong in the public repo (Frank 2026-07-14).
analysis/*.lua

# Website source — private, ours only (Frank 2026-07-19).
# The reasixty.com Astro project lives on the local-only `website` branch and
# must never reach the public repo. Ignoring it here stops the stray web/
# working-tree directory from being swept into a `git add .` on main.
#
# DO NOT let this line propagate to the `website` branch: web/ is TRACKED
# there, and while an ignore cannot untrack it, any NEW file added under web/
# would be silently skipped by `git add`. On a main -> website merge, drop
# this block on the website side.
/web/
