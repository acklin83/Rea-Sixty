{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "SDKVersion": 2,
  "Name": "Rea-Sixty Companion",
  "Version": "0.1.2.0",
  "Author": "Rea-Sixty",
  "UUID": "com.reasixty.companion",
  "Icon": "icons/plugin",
  "Description": "Fire Rea-Sixty / REAPER actions from your Stream Deck and mirror live surface state. Requires the Rea-Sixty REAPER extension (its localhost bridge on 127.0.0.1:49900).",
  "Category": "Rea-Sixty Companion",
  "CategoryIcon": "icons/plugin",
  "URL": "https://github.com/acklin83/Rea-Sixty",
  "CodePath": "plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "11"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Favourite",
      "UUID": "com.reasixty.companion.favourite",
      "Icon": "icons/action",
      "Tooltip": "Switch / cycle CS·BC·Fav favourites.",
      "PropertyInspectorPath": "pi/inspector.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "icons/blank",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Layer",
      "UUID": "com.reasixty.companion.layer",
      "Icon": "icons/action",
      "Tooltip": "Select binding layer 1 / 2 / 3.",
      "PropertyInspectorPath": "pi/inspector.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "icons/blank",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Hardware Mode",
      "UUID": "com.reasixty.companion.hardware",
      "Icon": "icons/action",
      "Tooltip": "Surface-wide toggles: Flip, Home, Settings, mirrors, overlays, learn.",
      "PropertyInspectorPath": "pi/inspector.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "icons/blank",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Navigation",
      "UUID": "com.reasixty.companion.navigation",
