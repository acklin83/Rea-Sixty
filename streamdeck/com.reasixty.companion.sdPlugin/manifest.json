          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Plug-in",
      "UUID": "com.reasixty.companion.plugin",
      "Icon": "icons/action",
      "Tooltip": "FX GUI toggles, chain, close-all, Quick-Learn, bypass/offline.",
      "PropertyInspectorPath": "pi/inspector.html",
      "Controllers": [
        "Keypad"
